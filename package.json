{
  "name": "zulipbot",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub workflow-optimizing bot",
  "license": "Apache-2.0",
  "repository": "github:zulip/zulipbot",
  "homepage": "https://github.com/zulip/zulipbot#readme",
  "bugs": "https://github.com/zulip/zulipbot/issues",
  "author": "Cynthia Lin <cynthialin1004@gmail.com> (https://synicalsyntax.com)",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "start": "node --disable-proto=throw --disallow-code-generation-from-strings ./src/index.ts",
    "pretest": "tsc && eslint && prettier --check .",
    "test:node": "env NODE_ENV=test node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --disable-proto=throw --disallow-code-generation-from-strings",
    "test": "node --run test:node"
  },
  "keywords": [
    "zulip",
    "bot",
    "bots",
    "github",
    "workflow",
    "synicalsyntax"
  ],
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "express": "^5.3.0",
    "lodash": "^4.18.1",
    "ts-extras": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^7.0.0",
    "nock": "^15.0.6",
    "partial-mock": "^1.1.0",
    "prettier": "^3.9.10",
    "type-fest": "^5.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
