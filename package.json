{
  "name": "zulipbot",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub workflow-optimizing bot",
  "license": "Apache-2.0",
  "repository": "github:zulip/zulipbot",
  "homepage": "https://github.com/zulip/zulipbot#readme",
  "bugs": "https://github.com/zulip/zulipbot/issues",
  "author": "Cynthia Lin <cynthialin1004@gmail.com> (https://synicalsyntax.com)",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "start": "node --disable-proto=throw --disallow-code-generation-from-strings ./src/index.ts",
    "pretest": "tsc && eslint && prettier --check .",
    "test:node": "env NODE_ENV=test node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --disable-proto=throw --disallow-code-generation-from-strings",
    "test": "node --run test:node"
  },
  "keywords": [
    "zulip",
    "bot",
    "bots",
    "github",
    "workflow",
    "synicalsyntax"
  ],
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/request-error": "^7.1.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "ts-extras": "^1.0.0"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^27.0.0",
    "@octokit/openapi-webhooks-types": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.21",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^3.0.1",
    "nock": "^14.0.15",
    "partial-mock": "^1.1.0",
    "prettier": "^3.8.4",
    "type-fest": "^5.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
